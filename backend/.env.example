# ===== 阶跃星辰 API（真实值写到 backend/.env，勿入库）=====
STEPFUN_API_KEY=your-stepfun-key-here
# ❗ 两套 plan 可用模型不同：代码默认用 step_plan/v1（stepaudio-2.5-tts 两边都可用）；
# 标准 /v1 下 step-tts-mini 才存在。无特殊需求保持 step_plan/v1，否则 TTS 可能 404。
STEPFUN_BASE_URL=https://api.stepfun.com/step_plan/v1
STEPFUN_WS_BASE=wss://api.stepfun.com/v1

# ===== 模型默认值（改一处全局生效）=====
STEP_TEXT_MODEL=step-3.5-flash
STEP_IMAGE_MODEL=step-image-edit-2
STEP_ASR_FILE_MODEL=stepaudio-2.5-asr
STEP_ASR_STREAM_MODEL=stepaudio-2.5-asr-stream
STEP_REALTIME_MODEL=stepaudio-2.5-realtime
STEP_REALTIME_VOICE=linjiajiejie

# 桌宠默认人设（实时语音 session instructions），RN 可运行时覆盖
STEP_REALTIME_INSTRUCTIONS=你是 MindOff 的桌宠，温柔、不催促、不评判，用简短口语陪伴用户。

# ===== 鉴权（JWT）=====
# 生产务必改成随机长字符串，如：openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-secret

# ===== 服务 =====
# 逗号分隔的允许来源；* 表示全部（开发期）。生产建议显式白名单（* 时不会携带凭证）
CORS_ORIGINS=*
# 运行环境：dev / prod。prod 下若 JWT_SECRET 仍为默认值会拒绝启动
APP_ENV=dev

# ===== 数据库 =====
# dev 默认 SQLite；生产容器内由 Dockerfile 设为 /data/mindoff.db
DATABASE_URL=sqlite:///./mindoff.db

# ===== 能力开关（生产 kill-switch，可回滚）=====
DREAMING_ENABLED=true
PROACTIVE_ENABLED=true

# ===== 彩云天气（按经纬度查实时天气）=====
CAIYUN_APP_KEY=
CAIYUN_APP_SECRET=
CAIYUN_CACHE_MINUTES=30
STEP_TTS_MODEL=stepaudio-2.5-tts
STEP_TTS_VOICE=yuanqishaonv

# ===== 邮箱验证码（SMTP；凭证仅留后端，关闭不影响密码登录）=====
EMAIL_LOGIN_ENABLED=false
SMTP_HOST=smtpdm.aliyun.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_EMAIL=
SMTP_PASSWORD=
SMTP_SENDER_NAME=喵灵
