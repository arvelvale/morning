{
  "apiType": "stageMode",
  "buildOption": {
    "arkOptions": {
      "buildProfileFields": {
        "CLOUD_DEBUG_TEST_LOGIN": false,
        "CLOUD_DEBUG_USERNAME": "",
        "CLOUD_DEBUG_PASSWORD": ""
      },
      "runtimeOnly": {
        "sources": []
      }
    }
  },
  "buildOptionSet": [
    {
      "name": "release",
      "arkOptions": {
        "obfuscation": {
          "ruleOptions": {
            "enable": false,
            "files": [
              "./obfuscation-rules.txt"
            ]
          }
        }
      }
    }
  ],
  "targets": [
    {
      "name": "default"
    },
    {
      "name": "cloudDebug",
      "config": {
        "buildOption": {
          "arkOptions": {
            "buildProfileFields": {
              "CLOUD_DEBUG_TEST_LOGIN": true,
              "CLOUD_DEBUG_USERNAME": "@param:cloudDebugUsername",
              "CLOUD_DEBUG_PASSWORD": "@param:cloudDebugPassword"
            }
          }
        }
      }
    }
  ]
}
